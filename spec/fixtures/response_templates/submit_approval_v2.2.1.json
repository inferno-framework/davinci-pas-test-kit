      "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/profile-pas-response-bundle|2.2.1"
    ]
  },
  "type": "collection",
  "timestamp": "2025-01-01T00:00:00Z",
  "entry": [
    {
      "fullUrl": "urn:uuid:5f0c6a8e-1d2b-4c7a-9e3f-8b4d2a6c1e70",
      "resource": {
        "resourceType": "ClaimResponse",
