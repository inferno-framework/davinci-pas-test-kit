<%- profile_test_files.each do |file_name| -%>
require_relative '<%= file_name %>'
<%- end -%>

module DaVinciPASTestKit
  module <%= module_name %>
    class <%= class_name %> < Inferno::TestGroup
      id :<%= group_id %>
      title '<%= title %>'
      description %(
        <%= description.gsub("\n", "\n" + " "*8) %>
      )
      run_as_group

      <%- profile_tests.each do |profile_test| -%>
      <%- if profile_test[:optional] -%>
      test from: :<%= profile_test[:id] %> do
        optional
        simulation_verification
      end
      <%- else -%>
      test from: :<%= profile_test[:id] %> do
        verifies_requirements '<%= response_verifies_requirement %>'
        simulation_verification
      end
      <%- end -%>
      <%- end -%>
    end
  end
end
