<%- if optional_must_support_enabled? -%>
require_relative '../../<%= ig_version %>/must_support/must_support_with_attestation_option'
<%- claim_profiles.each do |profile_metadata| -%>
require_relative '<%= test_file_for_profile(profile_metadata) %>'
<%- end -%>
<%- else -%>
<%- if operation == 'submit' -%>
require_relative '../../<%= ig_version %>/must_support/pas_client_must_support_request_profiles_test'
<%- end -%>
<%- profile_test_files.each do |file_name| -%>
require_relative '<%= file_name %>'
<%- end -%>
<%- end -%>

module DaVinciPASTestKit
  module <%= module_name %>
    class <%= class_name %> < Inferno::TestGroup
      id :<%= group_id %>
      title '<%= title %>'
      description %(
        <%=description.gsub("\n", "\n" + " "*8) %>
      )
      run_as_group
      
<%- if optional_must_support_enabled? -%>
<%- if operation == 'submit' -%>
      # At least one of the PAS request profiles must be present; unobserved must support
      # elements on the request profiles that are present may be attested as not collected.
      test from: :pas_client_<%= ig_version_for_id %>_must_support_with_attestation_option do
        id :pas_client_<%= ig_version_for_id %>_submit_request_profiles_must_support_with_attestation_option
        title 'At least one instance of a request profile (PAS Medication Request, PAS Service Request, PAS Device Request, or PAS Nutrition Order) is observed with all of its must support elements'
        config(
          options: {
            require_one_of: true,
            profiles: [
<%= attestation_profiles_block(request_profiles) %>
            ],
            ig_version: '<%= ig_version %>',
            type: 'request',
            operation: '<%= operation %>'
          }
        )
        description MustSupportWithAttestationOption.build_description(config.options)
      end

<%- end -%>
<%- claim_profiles.each do |profile_metadata| -%>
      # Mandatory - the <%= profile_metadata.profile_name %> profile must always be demonstrated.
      test from: :<%= test_id_for_profile(profile_metadata) %>

<%- end -%>
      # All other <%= operation %> request profiles - unobserved must support elements may be
      # attested as not collected by the client system.
      test from: :pas_client_<%= ig_version_for_id %>_must_support_with_attestation_option do
        id :pas_client_<%= ig_version_for_id %>_<%= operation %>_request_other_must_support_with_attestation_option
        title 'All other <%= operation %> request profile must support elements are observed'
        config(
          options: {
            require_one_of: false,
            profiles: [
<%= attestation_profiles_block(other_profiles) %>
            ],
            ig_version: '<%= ig_version %>',
            type: 'request',
            operation: '<%= operation %>'
          }
        )
        description MustSupportWithAttestationOption.build_description(config.options)
      end
<%- else -%>
      <%- if operation == 'submit' -%>
      test from: :pas_client_<%= ig_version_for_id %>_must_support_request_profiles
      <%- end -%>
      <%- profile_test_ids.each do |id| -%>
      test from: :<%= id %>
      <%- end -%>
<%- end -%>
    end
  end
end
